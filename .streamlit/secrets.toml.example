# Example secrets configuration for speech2summary Streamlit app

# Required: Groq API key for Whisper transcription
GROQ_API_KEY = "gsk_..."

# Required: Gemini API key(s) for summarization
# Single key (basic):
GEMINI_API_KEY = "AIza..."

# OR multiple keys for automatic quota rotation (recommended):
# GEMINI_API_KEY = ["AIza...key1", "AIza...key2", "AIza...key3"]
# When one key hits quota limit, the app automatically tries the next one

# Optional: Google Drive integration (all 3 required for Drive features)
# GOOGLE_CLIENT_ID = "769124924296-..."
# GOOGLE_CLIENT_SECRET = "GOCSPX-..."
# GOOGLE_REDIRECT_URI = "http://localhost:8501"

# Optional: Assistant modes for the "Assistant type" selector.
# Each key becomes a selectable mode and overrides/extends the built-in modes
# (general, veterinarian, developer).
#
# A single legacy string still works and shows up as a "custom" mode:
# SUMMARIZATION_PROMPT = "You are a meeting assistant. ..."
#
# Or define multiple modes as a TOML table. The table must be the LAST thing
# in this file, otherwise the keys above would be absorbed into it:
# [SUMMARIZATION_PROMPT]
# veterinarian = "Tu es docteur vétérinaire. Utilise la terminologie médicale française correcte..."
# developer = "You are a software development assistant. Summarize this technical discussion..."
